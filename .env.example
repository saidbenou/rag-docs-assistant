# --- Data ---
DATA_DIR=data/pdfs
CHROMA_PERSIST_DIR=data/chroma
COLLECTION_NAME=documents
# Leave empty for embedded Chroma; set it to use a Chroma server
CHROMA_HOST=
CHROMA_PORT=8000

# --- Chunking & retrieval ---
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# --- LLM: "ollama" (local, free) or "openai" (any OpenAI-compatible API) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0

# --- Langfuse monitoring (optional: leave empty to disable) ---
# Keys: https://cloud.langfuse.com (free tier) or a self-hosted instance
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Ragas evaluation: judge LLM (empty = same LLM as the assistant) ---
EVAL_LLM_PROVIDER=
EVAL_MODEL=
